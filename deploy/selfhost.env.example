APP_ORIGIN=https://draw.example.com
TELEGRAM_CLIENT_ID=123456789
TELEGRAM_CLIENT_SECRET=replace-with-login-client-secret-from-botfather
# Numeric Telegram user ID, not @username. Commas allow additional users.
TELEGRAM_ALLOWED_IDS=123456789

# Optional Google login (can be used alongside Telegram or on its own).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact email addresses, comma-separated; case is ignored.
GOOGLE_ALLOWED_EMAILS=

# Optional: assign boards from the old shared workspace to one account.
# Use the id returned by /api/me (Telegram numeric ID or google:<sub>).
WORKSPACE_LEGACY_OWNER_ID=
